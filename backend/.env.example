# ===========================================
# Environment Variables
# Adaptive Multimodal AI Interview System
# ===========================================
# IMPORTANT: Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.
# ===========================================

# Google Gemini
GEMINI_API_KEY=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Database (placeholder)
# DATABASE_URL=

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Email Notifications (Gmail SMTP)
# Requires a Gmail App Password, not the account's real password.
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Frontend (for interview invitation links)
FRONTEND_BASE_URL=
INTERVIEW_LINK_PATH_TEMPLATE=/interview/{token}

# Application
# APP_ENV=development
# APP_DEBUG=true
