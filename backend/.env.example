# ===========================================
# Environment Variables
# Adaptive Multimodal AI Interview System
# ===========================================
# IMPORTANT: Copy this file to backend/.env and fill in your values.
# Do NOT commit .env to version control.
# Never put real secrets in README files or git.
# ===========================================

# Google Gemini (required for JD parsing, CV parsing, eligibility
# semantic matching, and interview answer evaluation)
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.1-flash-lite when unset.
# GEMINI_MODEL=

# Optional LLM fallbacks used only when these keys are set.
# Gemini remains the primary provider.
# XAI_API_KEY=
# GROQ_API_KEY=

# LiveKit (required for a real voice interview)
# Local OSS --dev typically listens on ws://127.0.0.1:7880.
# Values must match the running LiveKit server.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# PostgreSQL (required for apply, invitations, dashboard, and
# InterviewResult persistence). SQLAlchemy / Alembic read this value.
# Example driver used by this repo (psycopg3):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=

# ElevenLabs TTS (primary TTS). Local MMS-TTS is used as fallback
# when ElevenLabs fails.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional STT/TTS provider overrides.
# STT defaults to whisper_local (faster-whisper, CPU).
# TTS defaults to elevenlabs, then local MMS-TTS fallback.
# STT_PROVIDER=whisper_local
# WHISPER_MODEL_SIZE=small
# WHISPER_CPU_THREADS=8
# TTS_PROVIDER=elevenlabs

# Voice worker HTTP bridge to the FastAPI API.
# Defaults to http://localhost:8000/api/v1 when unset.
# BACKEND_API_BASE_URL=http://localhost:8000/api/v1

# Email Notifications (Gmail SMTP)
# Required to send 48-hour interview invitations.
# Requires a Gmail App Password, not the account's real password.
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Frontend (for interview invitation links)
# FRONTEND_BASE_URL MUST be an absolute http:// or https:// URL.
# For local candidate UI this is typically http://localhost:5173
FRONTEND_BASE_URL=
INTERVIEW_LINK_PATH_TEMPLATE=/interview/{token}

# Recruiter UI origin for password-reset links. Absolute http(s) URL.
# Local recruiter UI is typically http://localhost:5174
# If unset, FRONTEND_BASE_URL is used as the fallback.
RECRUITER_FRONTEND_BASE_URL=

# Recruiter authentication (JWT). Never commit real secrets.
# JWT_SECRET_KEY must be a long random string in backend/.env.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application
# APP_ENV=development
# APP_DEBUG=true
