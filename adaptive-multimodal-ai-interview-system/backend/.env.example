# Google Gemini (JD/CV Intelligence & Interview LLM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# LiveKit (Real-time Audio Transport)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Database (placeholder)
# DATABASE_URL=

# Application
APP_ENV=development
APP_DEBUG=true
